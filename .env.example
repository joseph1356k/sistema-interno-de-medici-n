# Copia a .env.local para desarrollo. En producción van en las variables de entorno
# de Vercel; ninguno de estos valores debe estar en el repositorio.
#
# Qué es cada uno y quién lo pone: docs/puesta-en-marcha.md

# --- Base de datos -----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave `service_role`, no la `anon`. Salta las políticas de acceso, así que solo
# debe vivir en el servidor. Es la única que se lee la base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel -------------------------------------------------------------------
# Sin esta variable el panel no sirve nada, a propósito: un despliegue a medias no
# debe dejar accesibles datos por persona. Cambiarla cierra todas las sesiones.
DASHBOARD_PASSWORD=
# Firma las cookies de sesión. Aleatorio y largo (p. ej. `openssl rand -hex 32`).
# Nunca sale del servidor: aunque una cookie se filtre, no sirve para adivinar la
# contraseña. Cambiarlo también cierra todas las sesiones.
SESSION_SECRET=

# --- Ingesta -----------------------------------------------------------------
# Lo presenta el OTel Collector de cada PC. Va dentro de la clave de instalación.
INGEST_TOKEN=

# Mismo valor que en la configuración del webhook de GitHub.
GITHUB_WEBHOOK_SECRET=

# --- Trabajos programados ----------------------------------------------------
# Obligatorio: sin él, las rutas de cron rechazan todas las llamadas.
CRON_SECRET=
# El plazo de retención ya no va aquí: está en la tabla `settings` de la base
# (ver docs/puesta-en-marcha.md, «Retención»).

# Usuario u organización de GitHub. Funciona con ambos.
GITHUB_ORG=
# Token de solo lectura (Contents: read, Pull requests: read). Opcional: sin él el
# webhook funciona, pero no se recuperan eventos perdidos ni se refresca
# `mergeable_state`, que GitHub calcula aparte y manda nulo casi siempre.
GITHUB_API_TOKEN=

# --- Retrabajo (opcional) ----------------------------------------------------
# Sal del HMAC de rutas de archivo. Permite contar archivos retocados sin guardar
# ninguna ruta. Sin esta variable no se recoge nada.
# OJO: cambiarla invalida el histórico de retrabajo, porque los hashes dejan de
# coincidir con los ya guardados.
FILE_HASH_SALT=
